# Copy to .env and adjust the values. Never commit the real .env.
# Docker Compose interpola compose.yml / compose.prod.yml con estas variables.
# Vite tambien lee VITE_* desde este archivo. VAPID privado vive en Bcarpinteria/.env.

POSTGRES_USER=carpinteria
POSTGRES_PASSWORD=carpinteria_local
POSTGRES_DB=carpinteria
APP_ENV=LOCAL

# Auth local y origenes permitidos para el backend.
JWT_SECRET=
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
PUBLIC_BASE_URL=http://127.0.0.1:8080

# El frontend no habla con Supabase: todo pasa por la API. Nunca agregues
# claves de Supabase como VITE_* (Vite las incrusta en el bundle publico).
VITE_API_BASE=/api
VITE_PROXY_TARGET=http://backend:3000
